{
  "name": "zenith",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx server/dev.ts",
    "dev:site": "vite dev --mode site --host 127.0.0.1",
    "dev:client": "vite dev --host 127.0.0.1",
    "dev:server": "tsx --env-file-if-exists=.env.local server/main.ts",
    "build": "vite build",
    "build:site": "vite build --mode site && node scripts/prepare-site-build.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "preview:site": "vite preview --mode site --host 127.0.0.1",
    "start": "tsx --env-file-if-exists=.env.local server/main.ts",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck:engine": "tsc -p tsconfig.engine.json --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck:site": "tsc -p tsconfig.site.json --noEmit",
    "typecheck": "tsc --noEmit && npm run typecheck:engine && npm run typecheck:site"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.0",
    "@cloudflare/workers-types": "^5.20260826.1",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/inter": "^5.2.8",
    "@openai/sites-vite-plugin": "^0.2.0",
    "@types/node": "^25.6.2",
    "@types/react": "19.2.11",
    "@types/react-dom": "19.2.3",
    "@types/webxr": "^0.5.24",
    "@vitejs/plugin-react": "6.1.0",
    "@webgpu/types": "^0.1.70",
    "eslint": "^10.3.0",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "tsx": "4.20.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.4",
    "unplugin-typegpu": "0.11.6",
    "vite": "^8.0.11",
    "vitest": "^4.1.5",
    "wrangler": "^4.126.0"
  },
  "dependencies": {
    "@effect/platform": "0.97.1",
    "@effect/platform-browser": "0.77.1",
    "@effect/platform-node": "0.108.1",
    "effect": "3.22.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typegpu": "0.11.9"
  }
}
